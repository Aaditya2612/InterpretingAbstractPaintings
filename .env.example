# Copy this file to `.env` and fill in your key to enable Groq-powered
# interpretation. Without it, the app uses a local, deterministic interpreter
# and still works end-to-end.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides -----------------------------------------------------
# GROQ_MODEL=llama-3.3-70b-versatile
# CLIP_MODEL=openai/clip-vit-base-patch32
# PORT=8000
# MAX_INPUT_DIM=384
# TORCH_THREADS=4
# WARMUP=1
